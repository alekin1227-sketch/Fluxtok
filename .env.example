# Fluxtok v3
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/fluxtok"
APP_URL="http://localhost:3000"
SESSION_SECRET="gere-uma-chave-aleatoria-com-32-ou-mais-caracteres"
# 32 bytes em hexadecimal (64 chars). Ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="64_caracteres_hexadecimais_aqui"
NODE_ENV="development"

# Superadmin opcional (criado somente se não existir)
SUPERADMIN_NAME="Fluxtok Admin"
SUPERADMIN_EMAIL="admin@fluxtok.local"
SUPERADMIN_PASSWORD="troque-por-uma-senha-forte"

# TikTok Shop Partner Center — necessários para conectar lojas reais
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
TIKTOK_SERVICE_ID=""
TIKTOK_MARKET="ROW"

# Mercado Pago Assinaturas — necessários para checkout recorrente
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
FLUXTOK_STARTER_PRICE="49.90"
FLUXTOK_PRO_PRICE="79.90"

# SMTP opcional para recuperação de senha
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Fluxtok <no-reply@seudominio.com>"
