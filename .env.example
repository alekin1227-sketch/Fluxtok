# Aplicação
NODE_ENV=production
APP_URL=https://seu-dominio.up.railway.app
DATABASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# Superadmin inicial
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Fluxtok Admin

# Mercado Pago — produção
MERCADOPAGO_MODE=production
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Preços mensais
FLUXTOK_STARTER_PRICE=49.90
FLUXTOK_PRO_PRICE=79.90

# Assinatura anual
# Por padrão, o sistema calcula o anual usando o desconto abaixo.
FLUXTOK_ANNUAL_DISCOUNT_PERCENT=10
# Opcional: se quiser definir preços anuais fixos, use estas variáveis.
# FLUXTOK_STARTER_ANNUAL_PRICE=538.92
# FLUXTOK_PRO_ANNUAL_PRICE=862.92

# Em modo test apenas, use também:
# MERCADOPAGO_TEST_PAYER_EMAIL=

# Gmail / SMTP para redefinição de senha e avisos
# Ative a verificação em duas etapas no Gmail e use uma Senha de app de 16 caracteres.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=
SMTP_FROM="Fluxtok <seuemail@gmail.com>"

# TikTok Display API — opcional para atualizar views de vídeos da conta autorizada
# Deixe vazio enquanto não configurar.
TIKTOK_DISPLAY_ACCESS_TOKEN=

# TikTok Shop — opcional, quando o app Seller estiver aprovado
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
TIKTOK_MARKET=ROW
