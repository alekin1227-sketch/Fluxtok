generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  COMPANY_ADMIN
  MEMBER
}

enum CreatorStatus {
  FOUND
  CONTACTED
  RESPONDED
  INTERESTED
  PARTNERSHIP_ACCEPTED
  ACTIVE_COLLABORATION
  FINISHED
  NOT_INTERESTED
}

enum SampleStatus {
  PREPARING
  SENT
  IN_TRANSIT
  RECEIVED
  WAITING_CONTENT
  CONTENT_PUBLISHED
  CANCELED
}

enum ContentKind {
  VIDEO
  LIVE
  OTHER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingPlan {
  STARTER
  PRO
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  FINISHED
}

enum TikTokConnectionStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum SupportTicketStatus {
  OPEN
  WAITING_SUPPORT
  WAITING_CUSTOMER
  CLOSED
}

enum SupportSender {
  CUSTOMER
  SUPPORT
}

enum LegalDocument {
  TERMS
  PRIVACY
  TRIAL
  DATA_PROCESSING
  BILLING_RECURRING
}

model Company {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  active              Boolean  @default(true)
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users            User[]
  creators         Creator[]
  products         Product[]
  samples          Sample[]
  contents         Content[]
  campaigns        Campaign[]
  settings         Setting?
  trial            SubscriptionTrial?
  subscription     Subscription?
  tiktokConnection TikTokConnection?
  tiktokOAuthStates TikTokOAuthState[]
  auditLogs         AuditLog[]
  supportTickets    SupportTicket[]
  legalAcceptances  LegalAcceptance[]
  pixPayments       PixPayment[]

  @@map("companies")
}

model User {
  id           String   @id @default(cuid())
  companyId    String?
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions     Session[]
  resetTokens  PasswordResetToken[]
  tiktokOAuthStates TikTokOAuthState[]
  supportTickets     SupportTicket[]
  supportMessages    SupportMessage[]
  legalAcceptances   LegalAcceptance[]
  pixPayments        PixPayment[]

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Creator {
  id             String        @id @default(cuid())
  companyId      String
  name           String
  handle         String
  profileUrl     String?
  niche          String?
  followers      Int?
  contact        String?
  contactOrigin  String?
  notes          String?       @db.Text
  status         CreatorStatus @default(FOUND)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  samples        Sample[]
  contents       Content[]

  @@unique([companyId, handle])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([companyId, niche])
  @@map("creators")
}

model Product {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  sku             String?
  photoUrl        String?
  cost            Decimal? @db.Decimal(10, 2)
  tiktokUrl       String?
  tiktokProductId String?
  tiktokSyncedAt  DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  samples         Sample[]
  contents        Content[]
  campaigns       Campaign[]

  @@index([companyId, tiktokProductId])
  @@index([companyId, name])
  @@index([companyId, active])
  @@map("products")
}

model Campaign {
  id          String         @id @default(cuid())
  companyId   String
  productId   String?
  name        String
  objective   String?
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  samples     Sample[]

  @@index([companyId, status])
  @@index([companyId, productId])
  @@map("campaigns")
}

model Sample {
  id               String       @id @default(cuid())
  companyId        String
  creatorId        String
  productId        String
  campaignId       String?
  sentAt           DateTime?
  trackingCode     String?
  carrier          String?
  expectedAt       DateTime?
  receivedAt       DateTime?
  contentDueAt     DateTime?
  notes            String?      @db.Text
  status           SampleStatus @default(PREPARING)
  statusChangedAt  DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator          Creator      @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  campaign         Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contents         Content[]

  @@index([companyId, status])
  @@index([companyId, creatorId])
  @@index([companyId, productId])
  @@index([companyId, campaignId])
  @@index([companyId, contentDueAt])
  @@map("samples")
}

model Content {
  id              String      @id @default(cuid())
  companyId       String
  creatorId       String
  productId       String
  sampleId        String?
  tiktokContentId String?
  kind            ContentKind
  publishedAt     DateTime
  url             String
  views           Int?
  sales           Int?
  revenue         Decimal?    @db.Decimal(12, 2)
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator         Creator     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  product         Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  sample          Sample?     @relation(fields: [sampleId], references: [id], onDelete: SetNull)

  @@index([companyId, publishedAt])
  @@index([companyId, creatorId])
  @@index([companyId, productId])
  @@index([companyId, sampleId])
  @@map("contents")
}

model Setting {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  defaultContentDays   Int      @default(14)
  warningDaysBeforeDue Int      @default(3)
  inactiveCreatorDays  Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("settings")
}

// Mantido para compatibilidade com bancos da versão 2.
model SubscriptionTrial {
  id          String   @id @default(cuid())
  companyId   String   @unique
  trialEndsAt DateTime?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("subscription_trials")
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @unique
  status                 SubscriptionStatus @default(TRIALING)
  plan                   BillingPlan        @default(STARTER)
  trialStartsAt          DateTime            @default(now())
  trialEndsAt            DateTime
  currentPeriodEnd       DateTime?
  amount                 Decimal?            @db.Decimal(10, 2)
  currency               String              @default("BRL")
  provider               String?             @default("mercadopago")
  externalSubscriptionId String?
  cancelAtPeriodEnd      Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([externalSubscriptionId])
  @@map("subscriptions")
}


model PixPayment {
  id                String      @id @default(cuid())
  companyId         String
  userId            String
  plan              BillingPlan
  amount            Decimal     @db.Decimal(10, 2)
  status            String      @default("creating")
  externalPaymentId String?     @unique
  qrCode            String?     @db.Text
  qrCodeBase64      String?     @db.Text
  ticketUrl         String?     @db.Text
  expiresAt         DateTime?
  approvedAt        DateTime?
  idempotencyKey    String      @unique
  consentVersion    String
  consentIpHash     String?
  consentUserAgent  String?     @db.Text
  consentAcceptedAt DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([userId])
  @@map("pix_payments")
}

model TikTokConnection {
  id                    String                  @id @default(cuid())
  companyId             String                  @unique
  status                TikTokConnectionStatus  @default(CONNECTED)
  openId                String?
  sellerName            String?
  sellerBaseRegion      String?
  shopId                String?
  shopName              String?
  shopCipher            String?
  grantedScopes         String?                 @db.Text
  accessTokenEncrypted  String                  @db.Text
  refreshTokenEncrypted String                  @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  lastSyncAt            DateTime?
  lastError             String?                 @db.Text
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@map("tiktok_connections")
}

model TikTokOAuthState {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  stateHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("tiktok_oauth_states")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}


model PlatformSetting {
  id                String   @id @default("global")
  supportEmail      String?
  notificationEmail String?
  supportName       String   @default("Equipe Fluxtok")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("platform_settings")
}

model SupportTicket {
  id            String              @id @default(cuid())
  companyId     String
  createdById   String
  subject       String
  category      String              @default("Geral")
  status        SupportTicketStatus @default(OPEN)
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages      SupportMessage[]

  @@index([companyId, status])
  @@index([status, lastMessageAt])
  @@index([createdById])
  @@map("support_tickets")
}

model SupportMessage {
  id           String        @id @default(cuid())
  ticketId     String
  authorUserId String?
  sender       SupportSender
  message      String        @db.Text
  createdAt    DateTime      @default(now())

  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser   User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorUserId])
  @@map("support_messages")
}

model LegalAcceptance {
  id        String        @id @default(cuid())
  companyId String
  userId    String
  document  LegalDocument
  version   String
  ipHash    String?
  userAgent String?       @db.Text
  acceptedAt DateTime     @default(now())

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, acceptedAt])
  @@index([userId, document, acceptedAt])
  @@map("legal_acceptances")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model LoginRateLimit {
  key          String   @id
  attempts     Int      @default(0)
  windowStart  DateTime @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime @updatedAt

  @@map("login_rate_limits")
}
